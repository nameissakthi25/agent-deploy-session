# Copy to .env before the first bring-up. .env is git-ignored on purpose --
# a key in the compose file gets committed, and that is demonstrated as the
# wrong way during the session.
#
# Honest note for the room: a .env file on one box is the minimum, not the
# standard. A managed platform would give you a secret store with versioning
# and audit logs.

# --- model server -----------------------------------------------------------

# Hugging Face token. OPTIONAL -- Qwen3.8-27B-FP8 is Apache-2.0 and ungated,
# so the weights download without one. Set it only to raise your rate limit.
HF_TOKEN=

# Checkpoint vLLM serves. FP8 (~31GB) by default; BF16 is ~57.5GB and leaves
# far less KV cache on an 80GB card. If FP8 will not load on the A100, switch
# to Qwen/Qwen3.8-27B and lower --max-model-len in compose.yaml.
MODEL_ID=Qwen/Qwen3.8-27B-FP8

# Stable name the application code uses, set by --served-model-name in
# compose.yaml. Changing the checkpoint above does not change this.
MODEL_NAME=qwen3

# OpenAI-compatible endpoint. From inside another container this is
# http://vllm:8000/v1; from the host, localhost.
VLLM_BASE_URL=http://localhost:8000/v1

# --- retrieval (stages 2 and 3) ---------------------------------------------

# Connection string for the vector database. Hosted as its own container here;
# in production this would be a managed service and only this line would
# change. Stage 1 does not set it and does not need it.
QDRANT_URL=http://qdrant:6333

# Collection name that scripts/index_corpus.py writes and the retriever reads.
QDRANT_COLLECTION=it-kb

# Embedding model. ONNX on CPU, so embedding never touches the GPU.
EMBED_MODEL=BAAI/bge-small-en-v1.5
